# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (Platform-Provided)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Cloud SQL Schema Management Variables (Platform-Provided for Drizzle Kit)
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional custom salt for local client integrity obfuscation
VITE_BANDHAN_SECURE_SALT="bandhan_secure_salt_example"

# Cloudinary Media & Video Storage (100% Free Tier - No Credit Card Needed)
VITE_CLOUDINARY_CLOUD_NAME="dkhpt0h9z"
VITE_CLOUDINARY_UPLOAD_PRESET="bandhan_unsigned"
