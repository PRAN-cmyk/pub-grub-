rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Global Primitives ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // --- Entity Validation Blueprints (Anti-Update-Gap) ---
    function isValidUserPublicProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'username', 'avatar', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'nameBn', 'username', 'avatar', 'bio', 'city', 'createdAt', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && (!('nameBn' in data) || (data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 120))
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 80
        && data.avatar is string && data.avatar.size() >= 1 && data.avatar.size() <= 2048
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('city' in data) || (data.city is string && data.city.size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'updatedAt'])
        && data.uid == request.auth.uid
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.updatedAt is timestamp;
    }

    function isValidCloudPost(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'authorAvatar', 'content', 'privacy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['authorId', 'authorName', 'authorAvatar', 'content', 'privacy', 'driveFileId', 'driveFileName', 'driveWebViewLink', 'createdAt', 'updatedAt'])
        && data.authorId == request.auth.uid
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 120
        && data.authorAvatar is string && data.authorAvatar.size() >= 1 && data.authorAvatar.size() <= 2048
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 5000
        && data.privacy is string && data.privacy.size() <= 20 && (data.privacy == 'public' || data.privacy == 'friends' || data.privacy == 'only_me')
        && (!('driveFileId' in data) || (data.driveFileId is string && data.driveFileId.size() <= 128))
        && (!('driveFileName' in data) || (data.driveFileName is string && data.driveFileName.size() <= 256))
        && (!('driveWebViewLink' in data) || (data.driveWebViewLink is string && data.driveWebViewLink.size() <= 2048))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection: /users/{userId} (Public Profile without PII) ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && existing().uid == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserPublicProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserPublicProfile(incoming())
        && userId == request.auth.uid
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'nameBn', 'username', 'avatar', 'bio', 'city', 'updatedAt']);

      allow delete: if isVerifiedUser()
        && isValidId(userId)
        && userId == request.auth.uid
        && existing().uid == request.auth.uid;

      // --- Subcollection: /users/{userId}/private/{docId} (Strictly Isolated PII) ---
      match /private/{docId} {
        allow get: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && userId == request.auth.uid
          && docId == 'info'
          && exists(/databases/$(database)/documents/users/$(userId));

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && userId == request.auth.uid
          && docId == 'info'
          && isValidUserPrivateInfo(incoming())
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming())
          && userId == request.auth.uid
          && docId == 'info'
          && existing().uid == request.auth.uid
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(docId)
          && userId == request.auth.uid
          && existing().uid == request.auth.uid;
      }
    }

    // --- Collection: /cloudPosts/{postId} ---
    match /cloudPosts/{postId} {
      allow get: if isSignedIn()
        && isValidId(postId)
        && (existing().privacy == 'public' || existing().authorId == request.auth.uid);

      allow list: if isSignedIn()
        && (existing().privacy == 'public' || existing().authorId == request.auth.uid);

      allow create: if isVerifiedUser()
        && isValidId(postId)
        && isValidCloudPost(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser()
        && isValidId(postId)
        && isValidCloudPost(incoming())
        && existing().authorId == request.auth.uid
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Update post content or Drive link
          incoming().diff(existing()).affectedKeys().hasOnly(['content', 'driveFileId', 'driveFileName', 'driveWebViewLink', 'updatedAt']) ||
          // Action 2: Update post privacy
          incoming().diff(existing()).affectedKeys().hasOnly(['privacy', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(postId)
        && existing().authorId == request.auth.uid;
    }
  }
}
